[Unit]
Description=TorqWings Hangar runner (runs Bay scripts for Vercel)
After=network.target

[Service]
User=torqwings
WorkingDirectory=/home/torqwings/hangar
EnvironmentFile=/home/torqwings/hangar/runner.env
ExecStart=/usr/bin/python3 /home/torqwings/hangar/hangar_runner.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
