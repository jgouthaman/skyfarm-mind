# For local testing only (e.g. `uvicorn main:app --reload` with these
# exported). In Cloud Run, set this as the service's own env var /
# secret instead of a committed .env file.

# Shared secret this service checks against the X-TH-Shared-Secret header
# on every /invoke request. Must exactly match TH_GCP_SHARED_SECRET on the
# Vercel side (th-vercel-functions/.env.example). Required.
TH_GCP_SHARED_SECRET=

# Anthropic API key, used by Bay 01 (Mission)'s real agentic handler
# (agents/mission/handler.py) for its LLM calls. Without it, Bay 01 falls
# back to clearly-marked mock responses (mock: true) instead of failing.
ANTHROPIC_API_KEY=
