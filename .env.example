# Example environment variables -- names only, never real values.
# Copy what you need into .env (local) or the Vercel project settings.

# ── Bay 06 CFD Agent: solver run dispatch (src/lib/the-hangar/cfdDispatch.ts) ──
# "off" (default): runs stay 'queued', nothing is sent to GCP.
# "cloud_run_job": start the Cloud Run Job for each new run.
CFD_DISPATCH_MODE=off
# GCP project, region and Cloud Run Job name of the OpenFOAM solver job.
GCP_PROJECT_ID=
GCP_REGION=
CFD_JOB_NAME=
# Base64 of a service-account key JSON that may run the job
# (e.g. base64 -w0 key.json).
GCP_SA_KEY_JSON=
